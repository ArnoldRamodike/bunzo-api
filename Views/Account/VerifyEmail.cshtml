@using AuthSystem.ViewModels;
@model VerifyEmailViewModel;

@{
    ViewData["Title"] = "VerifyEmail";
    Layout = "~/Views/Shared/_AccountLayout.cshtml";
}


<div class="account-container">
    <div class="account-box">
        <h2 class="text-center mb-4">Verify Email</h2>
        <form asp-action="VerifyEmail" method="post">
            <div asp-valitaton-summury="ModelOnly" class="text-dark">
                <div class="mb-3">
                    <label asp-for="Email" class="form-label"></label>
                    <input asp-for="Email" class="form-control" />
                    <span asp-validatin-for="Email" class="text-danger"></span>
                </div>

                <input type="submit" value="Verify" class="btn btn-success w-100 p-2 mb-3">

                <div class="text-centre mt-3">
                    <a asp-controller="Home" asp-action="Index" class="text-decoration-none mt-3">Back</a>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial.cshtml");
    }
}