@page
@model BukyWebRazor.Pages.Categories.IndexModel
@{
    ViewData["Title"] = "index";
}

<div class="container">

    <div class="row pt-4 pb-3">
        <div class="col-6">
            <h2 class="text-primary">category List</h2>
        </div>
        <div class="col-6 text-end">
            <a asp-page="/categories/create" class="btn btn-primary">
                <i class="bi bi-plus-circle">Create New Category</i>
            </a>
        </div>
    </div>

    <table class="table table-boardered table-sriped">
        <thead>
            <tr>
                <th>
                    Category Name
                </th>
                <th>
                    Display Order
                </th>
                <th>
                    Actions
                </th>
            </tr>
            <thead>

            <tbody>
                    @foreach (var obj in Model.CategoryList.OrderBy(u => u.DispayOrder))
                    {
                    <tr>
                        <td>@obj.Name</td>
                        <td>@obj.DispayOrder</td>
                        <td>
                            <div class="w-75 btn-group " role="group">
                                <a asp-page="/Categories/Edit" asp-route-id="@obj.Id" class="btn btn-primary mx-2">
                                    <i class="bi bi-pencil-square"></i>Edit
                                </a>
                                <a asp-page="/Categories/delete" asp-route-id="@obj.Id" class="btn btn-danger mx-2">
                                    <i class="bi bi-trash-fill"></i>Delete
                                </a>
                            </div>
                        </td>

                    </tr>
                    }
            </tbody>
    </table>
</div>
