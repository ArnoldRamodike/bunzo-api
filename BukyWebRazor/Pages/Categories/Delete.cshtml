@page
@model BukyWebRazor.Pages.Categories.DeleteModel
@{
    ViewData["Title"] = "Delete";
}

<form method="post">
    <input asp-for="Category.Id" hidden />
    <div class="border p-3 mt-4">
        <div class="row pb-2">
            <h2 class="text-primary">Remove Category</h2>
            <hr>
        </div>
        <div class="mb-3 row p-1">
            <label class="p-0" asp-for="Category.Name"></label>
            <input class="for-control" disabled asp-for="Category.Name" />
        </div>
        <div class="mb-3 row p-1">
            <label class="p-0" asp-for="Category.DispayOrder"></label>
            <input class="for-control" disabled asp-for="Category.DispayOrder" />
        </div>
        <div class="row">
            <div class="col-6 col-md-3">
                <button type="submit" class="btn btn-danger form-control">Delete</button>
            </div>
            <div class="col-6 col-md-3">
                <a asp-controller="Category" asp-action="Index" class="btn btn-primary form-control"> Cancel
                </a>
            </div>
        </div>
    </div>

</form>