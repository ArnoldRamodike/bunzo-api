@model Category


<form method="post">
    <div class="border p-3 mt-4">
        <div class="row pb-2">
            <h2 class="text-primary">Edit Category</h2>
            <hr>
        </div>
        <div class="mb-3 row p-1">
            <label class="p-0" asp-for="Name"></label>
            <input class="for-control" asp-for="Name" />
            <span asp-validation-for="Name" class="text-danger"> </span>
        </div>
        <div class="mb-3 row p-1">
            <label class="p-0" asp-for="DispayOrder"></label>
            <input class="for-control" asp-for="DispayOrder" />
            <span asp-validation-for="DispayOrder" class="text-danger"> </span>
        </div>
        <div class="row">
            <div class="col-6 col-md-3">
                <button type="submit" class="btn btn-dark form-control">Update</button>
            </div>
            <div class="col-6 col-md-3">
                <a asp-controller="Category" asp-action="Index" class="btn btn-primary form-control"> Back to
                    List
                </a>
            </div>
        </div>
    </div>

</form>

@section Scripts {
    @{
        <partial name="_ValidationScriptsPartial" />
    }
}